{
	"name": "mizu",
	"description": "A lightweight, easily extensible interpreter loosely modeled after RISC-V assembly, for -betterC D",
	"license": "MIT",
	"targetType": "staticLibrary",
	"sourcePaths": ["source"],
	"importPaths": ["source"],

	"dependencies": {
		"libfp": {
			"repository": "git+https://github.com/doir-lang/libfp.git",
			"version": "674acd77c2b8411144c2e162015145df7edcf1a0"
		},
		"bc-threads": {
			"repository": "git+https://github.com/doir-lang/bc-threads.git",
			"version": "f3e45474cb010bcdca84c30b60619b4c61249dc1"
		}
	},

	"dflags-ldc": ["-betterC", "-checkaction=C"],
	"dflags-dmd": ["-betterC", "-checkaction=C"],

	"libs-posix": ["ffi"],
	"libs-linux": ["dl"],
	"libs-windows": ["ffi"],
	"lflags-windows": ["/LIBPATH:$PACKAGE_DIR/.vcpkg/lib"],

	"buildTypes": {
		"debug": { "buildOptions": ["debugMode", "debugInfo", "optimize"] },
		"unittest": { "buildOptions": ["unittests", "debugMode", "debugInfo", "optimize"] }
	},

	"configurations": [
		{
			"name": "library",
			"targetType": "staticLibrary"
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "mizu-tests",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": ["source", "tests"],
			"importPaths": ["source", "tests"],
			"lflags-linux": ["--export-dynamic"],
			"lflags-freebsd": ["--export-dynamic"],
			"lflags-osx": ["-export_dynamic"]
		},
		{
			"name": "unittest-coroutine",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "mizu-tests-coroutine",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": ["source", "tests"],
			"importPaths": ["source", "tests"],
			"lflags-linux": ["--export-dynamic"],
			"lflags-freebsd": ["--export-dynamic"],
			"lflags-osx": ["-export_dynamic"],
			"versions": ["MizuNoHardwareThreads"]
		},
		{
			"name": "example-fib",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "fib",
			"mainSourceFile": "examples/fib.d",
			"sourcePaths": ["source"],
			"importPaths": ["source"]
		},
		{
			"name": "example-bubble",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "bubble",
			"mainSourceFile": "examples/bubble.d",
			"sourcePaths": ["source"],
			"importPaths": ["source"]
		},
		{
			"name": "example-triangle",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "triangle",
			"mainSourceFile": "examples/triangle.d",
			"sourcePaths": ["source"],
			"importPaths": ["source"]
		},
		{
			"name": "example-threads",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "threads",
			"mainSourceFile": "examples/threads.d",
			"sourcePaths": ["source"],
			"importPaths": ["source"],
			"lflags-linux": ["--export-dynamic"],
			"lflags-freebsd": ["--export-dynamic"],
			"lflags-osx": ["-export_dynamic"]
		}
	]
}
